{
  "area": "gates",
  "tree": ["CMakeLists.txt", "CMakePresets.json", ".clang-tidy", ".github", "cmake", "include",
           "src", "tests", "tools", "fuzz", "bench", "scripts", "results", "docs"],
  "faults": [
    {
      "id": "gates-wire-pointer-cast",
      "breaks": "read_be casts a pointer over wire bytes",
      "check": "gates.py wire-pointer-cast",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "  T raw{};\n  std::memcpy(&raw, src, sizeof(T));\n",
          "new": "  T raw = *reinterpret_cast<const T*>(src);\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL wire-pointer-cast include/itch/wire\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-bare-branch-hint",
      "breaks": "A branch hint with no measured reason",
      "check": "gates.py bare-branch-hint",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "if (remaining == 0) {",
          "new": "if (remaining == 0) [[unlikely]] {"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL bare-branch-hint include/itch/reader\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-home-path",
      "breaks": "An absolute path naming a user",
      "check": "gates.py home-path",
      "mutations": [
        {
          "file": "scripts/gen_fuzz_corpus.py",
          "old": "REPO_ROOT = Path(__file__).resolve().parent.parent",
          "new": "REPO_ROOT = Path(\"/U\u0073ers/someone/itch\")"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL home-path scripts/gen_fuzz_corpus\\.py:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-private-address",
      "breaks": "A tailnet address in a comment",
      "check": "gates.py private-address",
      "mutations": [
        {
          "file": "tools/itch_census.cpp",
          "old": "// Walks a BinaryFILE ITCH 5.0 file",
          "new": "// Copied from 100.\u0036\u0034.0.1. Walks a BinaryFILE ITCH 5.0 file"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL private-address tools/itch_census\\.cpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-held-vendor",
      "breaks": "The held vendor named in a script",
      "check": "gates.py held-vendor",
      "mutations": [
        {
          "file": "scripts/gen_fuzz_corpus.py",
          "old": "Nothing here reads a\nNasdaq file.",
          "new": "Nothing here reads a\nc\u0062oe file."
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL held-vendor scripts/gen_fuzz_corpus\\.py:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-no-conditional-compilation",
      "breaks": "A test-only hook in the reader",
      "check": "gates.py no-conditional-compilation",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "#pragma once\n\n#include <array>",
          "new": "#pragma once\n\n#ifdef ITCH_FAULT\n#endif\n#include <array>"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL no-conditional-compilation include/itch/reader\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-no-abort-on-wire",
      "breaks": "An assert in the reader",
      "check": "gates.py no-abort-on-wire",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "if (remaining == 0) {",
          "new": "assert(remaining != 0);\n    if (remaining == 0) {"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL no-abort-on-wire include/itch/reader\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-toolchain-path",
      "breaks": "A hardcoded toolchain path in the build",
      "check": "gates.py toolchain-path",
      "mutations": [
        {
          "file": "cmake/ItchTidy.cmake",
          "old": "# clang-tidy runs at one pinned major version",
          "new": "# Uses x/.tool\u0063hain/env.sh. clang-tidy runs at one pinned major version"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL toolchain-path cmake/ItchTidy\\.cmake:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-private-name",
      "breaks": "A results file names the machine it was made on",
      "check": "gates.py private-name",
      "inputs": [
        {
          "file": "results/chase_debian.md",
          "op": "replace_text",
          "old": "Host: **debian**.",
          "new": "Host: **planted\u002dhost**."
        }
      ],
      "command": [
        "env",
        "ITCH_PRIVATE_NAMES=planted\u002dhost",
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL private-name results/chase_debian\\.md:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-attribution-reads-the-ledger",
      "breaks": "The attribution includes the ledger it must never read (T-MM-1)",
      "check": "gates.py attribution-without-ledger",
      "mutations": [
        {
          "file": "include/itch/mm/attribution.hpp",
          "old": "#include \"itch/mm/fills.hpp\"\n",
          "new": "#include \"itch/mm/fills.hpp\"\n#include \"itch/mm/ledger.hpp\"\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL attribution-without-ledger include/itch/mm/attribution\\.hpp:\\d+: includes itch/mm/ledger\\.hpp",
        "exit": 1
      }
    },
    {
      "id": "gates-linux-sampler-rule-drops-udp",
      "breaks": "The Linux sampler rule's every-kind check skips one kind, the UDP files, so a later debian UDP run with no load_rule line would pass the gates",
      "check": "test_gates.py test_the_linux_sampler_rule_holds_every_kind_of_file",
      "mutations": [
        {
          "file": "scripts/check_results.py",
          "old": "    fields = parse_header(text)\n    if fields.get(\"host\") != \"debian\":\n        return []\n    start = run_start(fields)\n",
          "new": "    fields = parse_header(text)\n    if fields.get(\"host\") != \"debian\" or name.startswith(\"udp_\"):\n        return []\n    start = run_start(fields)\n"
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_gates.py"
      ],
      "expect": {
        "signature": "^FAIL: test_the_linux_sampler_rule_holds_every_kind_of_file",
        "exit": 1
      }
    },
    {
      "id": "gates-linux-sampler-rule-no-run-start-passes",
      "breaks": "A debian results file that gives no run start is taken as from before the Linux sampler rule, so the check fails open",
      "check": "test_gates.py test_the_linux_sampler_rule_holds_every_kind_of_file",
      "mutations": [
        {
          "file": "scripts/check_results.py",
          "old": "    if start is None:\n        return [(\"run-start-unknown\",",
          "new": "    if start is None:\n        return []\n        return [(\"run-start-unknown\","
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_gates.py"
      ],
      "expect": {
        "signature": "^FAIL: test_the_linux_sampler_rule_holds_every_kind_of_file",
        "exit": 1
      }
    },
    {
      "id": "gates-linux-sampler-rule-later-udp-file",
      "breaks": "A debian UDP results file from after the Linux sampler rule's moment, with no load_rule line: the gate refuses it, and says no UDP driver writes the line yet",
      "check": "gates.py linux-sampler-rule",
      "mutations": [
        {
          "file": "results/udp_feed_debian_12302019.md",
          "old": "- run_started: 2026-11-12T02:03:12Z\n",
          "new": "- run_started: 2026-11-13T04:03:12Z\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}",
        "--only",
        "linux-sampler-rule"
      ],
      "expect": {
        "signature": "gates: FAIL linux-sampler-rule results/udp_feed_debian_12302019\\.md:1: load-rule-missing: .*no driver of the udp kind writes it yet",
        "exit": 1
      }
    }
  ]
}
