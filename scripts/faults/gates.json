{
  "area": "gates",
  "tree": ["CMakeLists.txt", "CMakePresets.json", ".clang-tidy", ".github", "cmake", "include",
           "src", "tests", "tools", "fuzz", "bench", "scripts", "results", "docs"],
  "faults": [
    {
      "id": "gates-wire-pointer-cast",
      "breaks": "read_be casts a pointer over wire bytes",
      "check": "gates.py wire-pointer-cast",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "  T raw{};\n  std::memcpy(&raw, src, sizeof(T));\n",
          "new": "  T raw = *reinterpret_cast<const T*>(src);\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL wire-pointer-cast include/itch/wire\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-bare-branch-hint",
      "breaks": "A branch hint with no measured reason",
      "check": "gates.py bare-branch-hint",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "if (remaining == 0) {",
          "new": "if (remaining == 0) [[unlikely]] {"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL bare-branch-hint include/itch/reader\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-home-path",
      "breaks": "An absolute path naming a user",
      "check": "gates.py home-path",
      "mutations": [
        {
          "file": "scripts/gen_fuzz_corpus.py",
          "old": "REPO_ROOT = Path(__file__).resolve().parent.parent",
          "new": "REPO_ROOT = Path(\"/U\u0073ers/someone/itch\")"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL home-path scripts/gen_fuzz_corpus\\.py:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-private-address",
      "breaks": "A tailnet address in a comment",
      "check": "gates.py private-address",
      "mutations": [
        {
          "file": "tools/itch_census.cpp",
          "old": "// Walks a BinaryFILE ITCH 5.0 file",
          "new": "// Copied from 100.\u0036\u0034.0.1. Walks a BinaryFILE ITCH 5.0 file"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL private-address tools/itch_census\\.cpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-held-vendor",
      "breaks": "The held vendor named in a script",
      "check": "gates.py held-vendor",
      "mutations": [
        {
          "file": "scripts/gen_fuzz_corpus.py",
          "old": "Nothing here reads a\nNasdaq file.",
          "new": "Nothing here reads a\nc\u0062oe file."
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL held-vendor scripts/gen_fuzz_corpus\\.py:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-no-conditional-compilation",
      "breaks": "A test-only hook in the reader",
      "check": "gates.py no-conditional-compilation",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "#pragma once\n\n#include <array>",
          "new": "#pragma once\n\n#ifdef ITCH_FAULT\n#endif\n#include <array>"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL no-conditional-compilation include/itch/reader\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-no-abort-on-wire",
      "breaks": "An assert in the reader",
      "check": "gates.py no-abort-on-wire",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "if (remaining == 0) {",
          "new": "assert(remaining != 0);\n    if (remaining == 0) {"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL no-abort-on-wire include/itch/reader\\.hpp:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-toolchain-path",
      "breaks": "A hardcoded toolchain path in the build",
      "check": "gates.py toolchain-path",
      "mutations": [
        {
          "file": "cmake/ItchTidy.cmake",
          "old": "# clang-tidy runs at one pinned major version",
          "new": "# Uses x/.tool\u0063hain/env.sh. clang-tidy runs at one pinned major version"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL toolchain-path cmake/ItchTidy\\.cmake:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-private-name",
      "breaks": "A results file names the machine it was made on",
      "check": "gates.py private-name",
      "inputs": [
        {
          "file": "results/chase_debian.md",
          "op": "replace_text",
          "old": "Host: **debian**.",
          "new": "Host: **planted\u002dhost**."
        }
      ],
      "command": [
        "env",
        "ITCH_PRIVATE_NAMES=planted\u002dhost",
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL private-name results/chase_debian\\.md:\\d+",
        "exit": 1
      }
    },
    {
      "id": "gates-attribution-reads-the-ledger",
      "breaks": "The attribution includes the ledger it must never read (T-MM-1)",
      "check": "gates.py attribution-without-ledger",
      "mutations": [
        {
          "file": "include/itch/mm/attribution.hpp",
          "old": "#include \"itch/mm/fills.hpp\"\n",
          "new": "#include \"itch/mm/fills.hpp\"\n#include \"itch/mm/ledger.hpp\"\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "gates: FAIL attribution-without-ledger include/itch/mm/attribution\\.hpp:\\d+: includes itch/mm/ledger\\.hpp",
        "exit": 1
      }
    },
    {
      "id": "gates-wire-c-style-struct-cast",
      "breaks": "read_be48 copies six wire bytes through a C-style cast to a pointer to a struct",
      "check": "gates.py wire-pointer-cast, C-style",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "  std::memcpy(wide.data() + 2, src, 6);\n",
          "new": "  struct Six {\n    std::byte b[6];\n  };\n  *(Six*)(wide.data() + 2) = *(const Six*)src;\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "^gates: FAIL wire-pointer-cast include/itch/wire\\.hpp:\\d+: C-style cast to a pointer to Six",
        "exit": 1
      }
    },
    {
      "id": "gates-wire-alias-cast",
      "breaks": "read_be reads its word through a reinterpret_cast to a pointer alias",
      "check": "gates.py wire-pointer-cast, through an alias",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "  T raw{};\n  std::memcpy(&raw, src, sizeof(T));\n",
          "new": "  using Word = const T*;\n  T raw = *reinterpret_cast<Word>(src);\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gates.py",
        "--root",
        "{tree}"
      ],
      "expect": {
        "signature": "^gates: FAIL wire-pointer-cast include/itch/wire\\.hpp:\\d+: reinterpret_cast to Word, a pointer through an alias",
        "exit": 1
      }
    },
    {
      "id": "gates-c-style-cast-only-to-integers",
      "breaks": "The C-style cast pattern is back to integer and floating pointees only",
      "check": "test_gates.py, a cast to a struct",
      "mutations": [
        {
          "file": "scripts/gates.py",
          "old": "    r\"\\(\\s*((?:[A-Za-z_][\\w:]*(?:\\s*<[^<>()]*>)?\\s+)*[A-Za-z_][\\w:]*(?:\\s*<[^<>()]*>)?)\"\n",
          "new": "    r\"\\(\\s*(?:const\\s+|volatile\\s+)*((?:std::)?u?int(?:16|32|64)_t|float|double|T)\"\n"
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_gates.py"
      ],
      "expect": {
        "signature": "^FAIL: test_a_cast_to_a_struct_or_through_an_alias \\("
      }
    },
    {
      "id": "gates-alias-cast-unread",
      "breaks": "No reinterpret_cast to an alias is read",
      "check": "test_gates.py, a cast through an alias",
      "mutations": [
        {
          "file": "scripts/gates.py",
          "old": "            if target not in POINTER_INTEGERS:\n",
          "new": "            if False:\n"
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_gates.py"
      ],
      "expect": {
        "signature": "^FAIL: test_a_cast_to_a_struct_or_through_an_alias \\("
      }
    },
    {
      "id": "gates-pointer-integer-flagged",
      "breaks": "A reinterpret_cast to uintptr_t, which casts no pointer over bytes, is flagged",
      "check": "test_gates.py, pointer integers allowed",
      "mutations": [
        {
          "file": "scripts/gates.py",
          "old": "POINTER_INTEGERS = {\"std::uintptr_t\", \"uintptr_t\", \"std::intptr_t\", \"intptr_t\"}\n",
          "new": "POINTER_INTEGERS = set()\n"
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_gates.py"
      ],
      "expect": {
        "signature": "^FAIL: test_byte_casts_declarations_and_pointer_integers_are_allowed \\("
      }
    },
    {
      "id": "gates-yaml-workflow-unread",
      "breaks": "gates.py reads *.yml workflows only, so a *.yaml one goes unchecked",
      "check": "test_gates.py, a yaml workflow",
      "mutations": [
        {
          "file": "scripts/gates.py",
          "old": "    return sorted([*workflows.glob(\"*.yml\"), *workflows.glob(\"*.yaml\")])\n",
          "new": "    return sorted(workflows.glob(\"*.yml\"))\n"
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_gates.py"
      ],
      "expect": {
        "signature": "^FAIL: test_a_yaml_workflow_is_read \\("
      }
    },
    {
      "id": "gates-actionlint-yaml-unread",
      "breaks": "lint_workflows.py hands actionlint the *.yml workflows only",
      "check": "test_gates.py, actionlint's workflow list",
      "mutations": [
        {
          "file": "scripts/lint_workflows.py",
          "old": "                  for path in [*folder.glob(\"*.yml\"), *folder.glob(\"*.yaml\")])\n",
          "new": "                  for path in folder.glob(\"*.yml\"))\n"
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_gates.py"
      ],
      "expect": {
        "signature": "^FAIL: test_actionlint_reads_a_yaml_workflow_too \\("
      }
    }
  ]
}
