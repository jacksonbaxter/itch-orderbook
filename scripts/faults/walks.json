{
  "area": "walks",
  "faults": [
    {
      "id": "walks-generator-loop-uncounted",
      "breaks": "The engine's rest walks its side in a loop of another form, which the counted copy's loop count does not see",
      "check": "cmake/ItchWalkEngine.cmake's loop count, at build time",
      "mutations": [
        {
          "file": "include/itch/backtest.hpp",
          "old": "    while (worse != kNoIndex && better(sim.side, levels_[worse].price, sim.price)) {\n      better_level = worse;\n      worse = levels_[worse].worse;\n    }\n",
          "new": "    for (; worse != kNoIndex && better(sim.side, levels_[worse].price, sim.price);\n         worse = levels_[worse].worse) {\n      better_level = worse;\n    }\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": []
      },
      "command": [
        "cmake",
        "--build",
        "--preset",
        "release",
        "--parallel",
        "3",
        "--target",
        "bench_walks"
      ],
      "expect": {
        "signature": "backtest\\.hpp has 7 loops over the simulated levels, not 8"
      }
    },
    {
      "id": "walks-generator-anchor-moved",
      "breaks": "The engine's text at a place the counted copy edits changes, so that edit no longer finds it",
      "check": "cmake/ItchWalkEngine.cmake's exactly-once anchors, at build time",
      "mutations": [
        {
          "file": "include/itch/backtest.hpp",
          "old": "    ++resting_[sim.locate];\n    ++resting_total_;\n",
          "new": "    ++resting_total_;\n    ++resting_[sim.locate];\n"
