    {
      "id": "mapbook-fifo-reversed",
      "breaks": "The map book puts each new order at the front of its level",
      "check": "itch_map_compare, the periodic whole-book hash: no top of book can see an order's place",
      "mutations": [
        {
          "file": "include/itch/map_book.hpp",
          "old": "    level->second.fifo.push_back({.reference = reference, .shares = shares});\n",
          "new": "    level->second.fifo.push_front({.reference = reference, .shares = shares});\n"
        },
        {
          "file": "include/itch/map_book.hpp",
          "old": "                                     .at = std::prev(level->second.fifo.end())});\n",
          "new": "                                     .at = level->second.fifo.begin()});\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "itch_map_compare"
        ]
      },
      "command": [
        "{build}/tools/itch_map_compare",
        "{tree}/tests/fixtures/oracle/session.itch",
        "--max-orders",
        "4096",
        "--max-levels",
        "4096",
        "--hash-every",
        "100"
      ],
      "expect": {
        "signature": "MAP_DIVERGENCE kind=hash message=\\d+ "
      }
    },
