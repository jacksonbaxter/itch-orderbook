{
  "area": "mapbook",
  "faults": [
    {
      "id": "mapbook-execute-skips-level-total",
      "breaks": "A partial execute or cancel leaves the map book's level total as it was",
      "check": "itch_map_compare, top of book after every message",
      "mutations": [
        {
          "file": "include/itch/map_book.hpp",
          "old": "      order.level->second.aggregate_shares -= shares;\n",
          "new": ""
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "itch_map_compare"
        ]
      },
      "command": [
        "{build}/tools/itch_map_compare",
        "{tree}/tests/fixtures/oracle/session.itch",
        "--max-orders",
        "4096",
        "--max-levels",
        "4096"
      ],
      "expect": {
        "signature": "MAP_DIVERGENCE kind=top message=\\d+ type=[ECX] "
      }
    },
    {
      "id": "mapbook-empty-level-kept",
