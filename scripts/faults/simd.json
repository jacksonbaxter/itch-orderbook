      "id": "simd-parser-tail-on-the-kernel",
      "breaks": "The parser hands messages within kOverread bytes of the end to the overreading kernel",
      "check": "test_kernels Kernels.MessagesNearTheEndGoToTheScalarKernel",
      "mutations": [
        {
          "file": "include/itch/kernels/parse.hpp",
          "old": "    if (after >= Kernel::kOverread) {\n",
          "new": "    if (after + Kernel::kOverread >= Kernel::kOverread) {\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_kernels"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_kernels"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] Kernels\\.MessagesNearTheEndGoToTheScalarKernel",
        "exit": 1
      }
    },
