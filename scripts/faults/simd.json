      "check": "test_kernels Kernels.AKernelThatCannotRunIsAnErrorWithItsReason",
      "mutations": [
        {
          "file": "include/itch/kernels/select.hpp",
          "old": "  if (!built(*id)) {\n    return std::unexpected(std::format(\"kernel {} is not built: this is an {} build, with {}\",\n                                       name, kArch, built_names()));\n  }\n",
          "new": "  if (!built(*id)) {\n    return Selected{KernelId::scalar, false};\n  }\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_kernels"
        ],
        "gtest": true
      },
      "command": [
