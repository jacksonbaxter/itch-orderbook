{
  "area": "parse",
  "faults": [
    {
      "id": "parse-decode-skips-a-type",
      "breaks": "T-PARSE-2's decode leaves Trade (P), one of itch-book's ten types, undecoded",
      "check": "test_parse_passes ParsePasses.TheDecodeFoldsItchBooksFieldsOfEachOfItsTenTypes",
      "mutations": [
        {
          "file": "bench/parse_passes.hpp",
          "old": "      case Trade::kType: {\n        const Trade trade = Trade::from_wire(m);\n        fold += trade.match_number + trade.shares;\n        break;\n      }\n",
          "new": ""
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_parse_passes"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_parse_passes"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] ParsePasses\\.TheDecodeFoldsItchBooksFieldsOfEachOfItsTenTypes",
        "exit": 1
      }
    },
    {
      "id": "parse-decode-reads-no-field",
      "breaks": "T-PARSE-2's decode folds nothing, so the compiler need read no field",
      "check": "test_parse_passes ParsePasses.TheDecodeMatchesThePlainReferenceOnASession",
      "mutations": [
        {
          "file": "bench/parse_passes.hpp",
          "old": "  totals.fold = fold;\n  return totals;\n}\n\n// The sum of every field",
          "new": "  totals.fold = 0;\n  return totals;\n}\n\n// The sum of every field"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_parse_passes"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_parse_passes"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] ParsePasses\\.TheDecodeMatchesThePlainReferenceOnASession",
        "exit": 1
      }
    },
    {
      "id": "parse-strict-skips-a-field",
      "breaks": "T-PARSE-3's strict decode leaves a Trade's match number out of its sum",
