      "breaks": "T-PARSE-2's decode leaves Trade (P), one of itch-book's ten types, undecoded",
      "check": "test_parse_passes ParsePasses.TheDecodeFoldsItchBooksFieldsOfEachOfItsTenTypes",
      "mutations": [
        {
          "file": "bench/parse_passes.hpp",
          "old": "          case Trade::kType: {\n            const Trade trade = Trade::from_wire(m);\n            fold += trade.match_number + trade.shares;\n            break;\n          }\n",
          "new": ""
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_parse_passes"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_parse_passes"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] ParsePasses\\.TheDecodeFoldsItchBooksFieldsOfEachOfItsTenTypes",
        "exit": 1
      }
