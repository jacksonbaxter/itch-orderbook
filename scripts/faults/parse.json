    {
      "id": "parse-walk-skips-empty-frames",
      "breaks": "T-PARSE-1's walk counts a frame only if it has a payload",
      "check": "test_parse_passes ParsePasses.TheWalkCountsEveryFrameToTheEnd",
      "mutations": [
        {
          "file": "bench/parse_passes.hpp",
          "old": "  totals.stopped_at = walk_frames(bytes, [&](const std::byte*, std::size_t) { ++totals.messages; });\n",
          "new": "  totals.stopped_at = walk_frames(bytes, [&](const std::byte*, std::size_t length) {\n    totals.messages += length != 0 ? 1U : 0U;\n  });\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_parse_passes"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_parse_passes"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] ParsePasses\\.TheWalkCountsEveryFrameToTheEnd",
        "exit": 1
      }
    },
