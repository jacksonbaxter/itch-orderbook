      "id": "backtester-replay-sim-order-in-book",
      "breaks": "A resting simulated order is written into the replayed exchange book",
      "check": "test_backtest_validity S46",
      "mutations": [
        {
          "file": "include/itch/backtest.hpp",
          "old": "  void rest(std::uint32_t slot) noexcept {\n    SimOrder& sim = orders_[slot];\n",
          "new": "  void rest(std::uint32_t slot) noexcept {\n    SimOrder& sim = orders_[slot];\n    {\n      std::array<std::byte, 36> add{};\n      add[0] = std::byte{'A'};\n      add[1] = static_cast<std::byte>(sim.locate >> 8U);\n      add[2] = static_cast<std::byte>(sim.locate & 0xFFU);\n      add[14] = std::byte{0x7F};\n      add[17] = static_cast<std::byte>(slot >> 8U);\n      add[18] = static_cast<std::byte>(slot & 0xFFU);\n      add[19] = sim.side == Side::bid ? std::byte{'B'} : std::byte{'S'};\n      for (std::size_t i = 0; i < 4; ++i) {\n        add[20 + i] = static_cast<std::byte>((sim.remaining >> (24U - (8U * i))) & 0xFFU);\n        add[32 + i] = static_cast<std::byte>((sim.price >> (24U - (8U * i))) & 0xFFU);\n      }\n      static_cast<void>(book_.apply(add));\n    }\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_backtest_validity"
        ]
      },
      "command": [
        "{build}/tests/test_backtest_validity"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] ReplayUnchanged\\.S46TheRealBookIsIdenticalAfterEveryMessage"
