{
  "area": "types",
  "faults": [
    {
      "id": "types-block-not-restarted",
      "breaks": "Every block of a typed pass is timed from the pass's first reading",
      "check": "test_bench_replay TypedTime.EachBlockIsTimedWholeAndCountedByType",
      "mutations": [
        {
          "file": "bench/typed_time.hpp",
          "old": "      pass.quarters[quarter].add(counts, now - opened, floor_ticks);\n      opened = now;\n      counts = {};",
          "new": "      pass.quarters[quarter].add(counts, now - opened, floor_ticks);\n      counts = {};"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_bench_replay"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_bench_replay"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] TypedTime\\.EachBlockIsTimedWholeAndCountedByType",
        "exit": 1
      }
    },
    {
