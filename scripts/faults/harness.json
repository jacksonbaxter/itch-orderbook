    {
      "id": "harness-fetch-unpacked-name",
      "breaks": "A day is unpacked under Nasdaq's .txt name though the manifest gives it another, so macOS types the binary day as plain text and Spotlight's importer reads it",
      "check": "scripts/test_fetch_data.py",
      "mutations": [
        {
          "file": "scripts/fetch_data.py",
          "old": "    return day.get(\"unpacked_name\", day[\"name\"])\n",
          "new": "    return day[\"name\"]\n"
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/test_fetch_data.py"
      ],
      "expect": {
        "signature": "^FAIL: test_a_day_with_an_unpacked_name_is_unpacked_under_it"
      }
    },
    {
      "id": "harness-fetch-range-status",
      "breaks": "The download accepts a chunk that is not status 206, as a resumed Range must be",
      "check": "scripts/test_fetch_data.py",
      "mutations": [
        {
          "file": "scripts/fetch_data.py",
          "old": "    if status != 206:\n        raise ChunkRejected(f\"status {status}, expected 206\")\n",
          "new": ""
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/test_fetch_data.py"
      ],
      "expect": {
        "signature": "^FAIL: test_status_200_is_rejected"
      }
    },
    {
      "id": "harness-fuzz-reader-planted-crash",
      "breaks": "A crash reachable from wire bytes, on one frame length no seed has",
      "check": "fuzz_reader under libFuzzer finds it by mutation",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "    if (expected == 0) {\n",
          "new": "    if (length == 77) {\n      __builtin_abort();\n    }\n    if (expected == 0) {\n"
        }
      ],
      "build": {
        "preset": "fuzz",
        "targets": [
          "fuzz_reader"
        ],
        "gtest": false
      },
      "command": [
        "{build}/fuzz/fuzz_reader",
        "-seed=1",
        "-max_total_time=30",
        "-artifact_prefix={build}/fuzz/artifacts/",
        "{build}/fuzz/corpus/fuzz_reader",
        "{tree}/fuzz/corpus/fuzz_reader"
      ],
      "expect": {
        "signature": "ERROR: libFuzzer: deadly signal"
      }
    },
    {
      "id": "harness-fuzz-reader-oracle",
      "breaks": "An unknown type of one length no seed has is called bad_length",
