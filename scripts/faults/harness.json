{
  "area": "harness",
  "faults": [
    {
      "id": "harness-corpus-replay-reader",
      "breaks": "read_alpha drops the last byte of an alpha field",
      "check": "corpus_fuzz_reader, round-trip oracle over committed seeds",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "std::memcpy(field.data(), src, N);",
          "new": "std::memcpy(field.data(), src, N - 1);"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "fuzz_reader"
        ]
      },
      "command": [
        "ctest",
        "--preset",
        "release",
        "-R",
        "^corpus_fuzz_reader$"
      ],
      "expect": {
        "signature": "FUZZ_CHECK failed: std::ranges::equal\\(again, frame\\.payload\\)"
      }
    },
    {
      "id": "harness-corpus-replay-decode",
      "breaks": "read_alpha drops the last byte of an alpha field",
      "check": "corpus_fuzz_decode, round-trip oracle over committed seeds",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "std::memcpy(field.data(), src, N);",
          "new": "std::memcpy(field.data(), src, N - 1);"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "fuzz_decode"
        ]
      },
      "command": [
        "ctest",
        "--preset",
        "release",
        "-R",
        "^corpus_fuzz_decode$"
      ],
      "expect": {
        "signature": "FUZZ_CHECK failed: (again == buffer|std::ranges::equal)"
      }
    },
    {
      "id": "harness-corpus-missing",
      "breaks": "The committed seeds are gone, so a replay would pass having run nothing",
      "check": "standalone_runner refuses an empty corpus",
      "inputs": [
        {
          "file": "fuzz/corpus/fuzz_reader",
          "op": "remove_files"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "fuzz_reader"
        ]
      },
      "command": [
        "ctest",
        "--preset",
        "release",
        "-R",
        "^corpus_fuzz_reader$"
      ],
      "expect": {
        "signature": "no corpus inputs found"
      }
    },
    {
      "id": "harness-corpus-seed-tampered",
      "breaks": "One committed seed no longer matches the fixtures",
      "check": "gen_fuzz_corpus.py --check",
      "inputs": [
        {
          "file": "fuzz/corpus/fuzz_reader/frame-53-S",
          "op": "flip_byte",
          "offset": 10
        }
      ],
      "command": [
        "{python}",
        "{tree}/scripts/gen_fuzz_corpus.py",
        "--check"
      ],
      "expect": {
        "signature": "fuzz_reader/frame-53-S: bytes differ",
        "exit": 1
      }
    },
    {
      "id": "harness-fixture-edited",
      "breaks": "A hand-written fixture changes without the corpus",
      "check": "gen_fuzz_corpus.py --check",
      "mutations": [
        {
          "file": "tests/support/fixtures.hpp",
          "old": "0x00, 0x00, 0x01, 0x2C,                          // Shares 300",
          "new": "0x00, 0x00, 0x01, 0x2D,                          // Shares 301"
