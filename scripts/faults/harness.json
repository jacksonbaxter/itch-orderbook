      "check": "itch_wasm_smoke in node, through the wasm preset",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "if constexpr (std::endian::native == std::endian::little) {",
          "new": "if constexpr (std::endian::native == std::endian::big) {"
        }
