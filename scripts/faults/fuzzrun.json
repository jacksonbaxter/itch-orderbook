      "id": "fuzz-report-target-missing-passes",
      "breaks": "fuzz_report.py writes a run in which a target fuzz/CMakeLists.txt adds has no status line, and check passes a file with no row for it",
      "check": "test_fuzz_report.py FuzzReport.test_a_target_missing_is_refused",
      "mutations": [
        {
          "file": "scripts/fuzz_report.py",
          "old": "    missing = [name for name in expected if name not in targets]\n",
          "new": "    missing = []\n"
        },
        {
          "file": "scripts/fuzz_report.py",
          "old": "\"targets\": [(name, targets[name]) for name in expected]}",
          "new": "\"targets\": [(name, targets[name]) for name in expected if name in targets]}"
        },
        {
          "file": "scripts/fuzz_report.py",
          "old": "    missing = [name for name in expected if name not in rows]\n    if missing or len(rows) != len(expected):",
          "new": "    missing = []\n    if missing:"
        }
      ],
      "command": [
        "{python}",
        "-B",
        "{tree}/scripts/test_fuzz_report.py",
        "FuzzReport.test_a_target_missing_is_refused"
      ],
      "expect": {
        "signature": "^FAIL: test_a_target_missing_is_refused",
        "exit": 1
      }
    },
