      "build": {
        "preset": "release",
        "targets": [
          "test_book_variants"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_book_variants"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] Lookahead\\.HandsOverEveryFrameFrameReaderDoesInOrder",
        "exit": 1
