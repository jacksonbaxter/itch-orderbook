      "check": "test_book_variants Lookahead.HandsOverEveryFrameFrameReaderDoesInOrder",
      "mutations": [
        {
          "file": "include/itch/lookahead.hpp",
          "old": "    const Frame frame = ring_[handed_ & kRingMask];\n",
          "new": "    const Frame frame = ring_[(handed_ + (handed_ == 100 ? 1U : 0U)) & kRingMask];\n"
        }
