          "file": "include/itch/reader.hpp",
          "old": "    if (length > remaining - kLengthPrefix) {\n      counters_.truncated_payload = 1;\n      return {.status = FrameStatus::truncated_payload, .offset = offset_, .payload = {}};\n    }\n",
          "new": ""
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_reader"
        ]
      },
      "command": [
        "{build}/tests/test_reader"
