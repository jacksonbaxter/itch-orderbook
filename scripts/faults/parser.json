      "expect": {
        "signature": "\\[  FAILED  \\] Reader\\.OversizedLengthBeyondTheInputIsATypedFailure"
      }
    },
    {
      "id": "parser-unknown-type-not-skipped",
      "breaks": "An unknown type is not skipped by its length, so the walk falls into its payload",
      "check": "test_reader (Reader.UnknownTypeIsSkippedByLengthAndCounted)",
      "mutations": [
        {
          "file": "include/itch/reader.hpp",
          "old": "    offset_ += kLengthPrefix + length;\n",
          "new": "    offset_ += frame.status == FrameStatus::unknown_type ? kLengthPrefix : kLengthPrefix + length;\n"
