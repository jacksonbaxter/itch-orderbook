{
  "area": "parser",
  "faults": [
    {
      "id": "parser-field-offset",
      "breaks": "Add Order price is read one byte early",
      "check": "test_messages (Messages.AddOrder)",
      "mutations": [
        {
          "file": "include/itch/messages.hpp",
          "old": ".stock = read_alpha<8>(m + 24),\n        .price = read_be<std::uint32_t>(m + 32),\n    };",
          "new": ".stock = read_alpha<8>(m + 24),\n        .price = read_be<std::uint32_t>(m + 31),\n    };"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_messages"
        ]
      },
      "command": [
        "{build}/tests/test_messages"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] Messages\\.AddOrder"
      }
    },
    {
      "id": "parser-read-be48-eight-bytes",
      "breaks": "read_be48 loads 8 bytes and shifts, reading 2 bytes past the field. Every value stays right",
      "check": "test_guard_page (GuardPage.ReadBe48ReadsExactlySixBytes)",
      "mutations": [
        {
          "file": "include/itch/wire.hpp",
          "old": "  std::array<std::byte, sizeof(std::uint64_t)> wide{};\n  std::memcpy(wide.data() + 2, src, 6);\n  return read_be<std::uint64_t>(wide.data());\n",
          "new": "  return read_be<std::uint64_t>(src) >> 16U;\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_guard_page"
        ]
      },
      "command": [
        "{build}/tests/test_guard_page"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] GuardPage\\.ReadBe48ReadsExactlySixBytes"
      }
    },
    {
