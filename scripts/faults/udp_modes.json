    {
      "id": "udp-bench-slot-unchecked",
      "breaks": "bench_udp runs a batching mode whose slot cannot hold the packing's largest datagram",
      "check": "test_bench_udp_cli.py, the small-slot cases",
      "mutations": [
        {
          "file": "bench/bench_udp.cpp",
          "old": "options.plan.max_datagram + udp::kSlotOverhead > options.mode_options.slot_bytes) {\n",
          "new": "options.plan.max_datagram + udp::kSlotOverhead > options.mode_options.slot_bytes + 65536) {\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "bench_udp"
        ],
        "gtest": false
      },
      "command": [
        "{python}",
        "-B",
        "{tree}/tests/test_bench_udp_cli.py",
        "{build}/bench/bench_udp",
        "{build}/bench_udp_fault",
        "{tree}/tests/fixtures/oracle/session.itch",
        "S1,S2,S3,S4,U1,U2,U3,U4,U5"
      ],
      "expect": {
        "signature": "bench_udp cli: FAIL S3 small slot"
      },
      "system": "Linux"
