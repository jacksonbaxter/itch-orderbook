    {
      "id": "udp-feed-schedule-runs-backwards",
      "breaks": "The feed schedule follows a timestamp that goes back, so a packet is due before the one ahead of it",
      "check": "test_udp Schedule.AFeedScheduleNeverRunsBackwards",
      "mutations": [
        {
          "file": "bench/udp/sender.hpp",
          "old": "    last = offset > last ? offset : last;\n",
          "new": "    last = offset;\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_udp"
        ],
        "gtest": true
