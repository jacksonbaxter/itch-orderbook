{
  "area": "udp_modes",
  "faults": [
    {
      "id": "udp-snmp-missing-column-read",
      "breaks": "A /proc/net/snmp Udp: pair without every kept column is read, the missing ones as 0",
      "check": "test_udp KernelCounters.TheUdpLinesOfSnmpAreReadByName",
      "mutations": [
        {
          "file": "bench/udp/kernel_counters.hpp",
          "old": "  if (found != kUdpColumns.size()) {\n",
          "new": "  if (found == 0) {\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_udp"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_udp",
        "--gtest_filter=KernelCounters.TheUdpLinesOfSnmpAreReadByName"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] KernelCounters\\.TheUdpLinesOfSnmpAreReadByName"
      }
    },
    {
      "id": "udp-softnet-read-as-decimal",
