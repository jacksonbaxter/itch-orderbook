{
  "area": "udp",
  "faults": [
    {
      "id": "udp-mold-count-byte-order",
      "breaks": "The header's count is written low byte first",
      "check": "test_mold MoldHeader.LaysOutSessionSequenceAndCountAsTheSpecSays",
      "mutations": [
        {
          "file": "include/itch/mold.hpp",
          "old": "  dst[kCountOffset] = static_cast<std::byte>(header.count >> 8U);\n  dst[kCountOffset + 1] = static_cast<std::byte>(header.count & 0xFFU);\n",
          "new": "  dst[kCountOffset + 1] = static_cast<std::byte>(header.count >> 8U);\n  dst[kCountOffset] = static_cast<std::byte>(header.count & 0xFFU);\n"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_mold"
        ],
        "gtest": true
      },
      "command": [
        "{build}/tests/test_mold",
        "--gtest_filter=MoldHeader.LaysOutSessionSequenceAndCountAsTheSpecSays"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] MoldHeader\\.LaysOutSessionSequenceAndCountAsTheSpecSays"
      }
    },
    {
