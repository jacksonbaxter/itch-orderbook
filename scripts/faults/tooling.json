      "command": [
        "cmake",
        "--build",
        "--preset",
        "release",
        "--parallel",
        "6",
        "--target",
        "itch_parser"
      ],
      "expect": {
        "signature": "\\[-Werror,-Wshorten-64-to-32\\]"
      }
    },
