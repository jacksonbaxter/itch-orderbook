      ],
      "build": {
        "preset": "release",
        "targets": []
      },
      "command": [
        "cmake",
        "--build",
        "--preset",
        "release",
        "--parallel",
        "6",
        "--target",
        "itch_parser"
      ],
      "expect": {
        "signature": "\\[-Werror,-Wsign-conversion\\]"
      }
    },
    {
      "id": "tooling-werror-shadow",
