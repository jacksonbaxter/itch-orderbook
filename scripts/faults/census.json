        "--day",
        "all-types",
        "--manifest",
        "{tree}/scripts/faults/fixtures/census_manifest.json",
        "--file",
        "{tree}/fuzz/corpus/fuzz_reader/stream-all-types",
        "--census",
        "{build}/tools/itch_census"
      ],
      "expect": {
        "signature": "census: MISMATCH end: manifest end_of_input, census truncated_payload",
        "exit": 1
      }
    },
    {
      "id": "census-input-clean-prefix",
      "breaks": "The day loses its whole final frame, leaving a well-formed prefix",
