    {
      "id": "census-tool-last-frame-tracking",
      "breaks": "A frame after the closing S/C no longer clears it",
      "check": "test_census_cli",
      "mutations": [
        {
          "file": "tools/itch_census.cpp",
          "old": "    last_event.reset();\n",
          "new": ""
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "itch_census"
        ]
      },
      "command": [
        "ctest",
        "--preset",
        "release",
        "-R",
        "^test_census_cli$"
      ],
      "expect": {
        "signature": "bad_length_is_not_the_last_message: exit 0, wanted 1"
      }
    },
    {
      "id": "census-tool-last-message-unchecked",
      "breaks": "The tool stops requiring S/C at the end",
      "check": "test_census_cli",
      "mutations": [
        {
          "file": "tools/itch_census.cpp",
          "old": "if (!last_event || last_event->event_code != 'C') {",
          "new": "if (!last_event) {"
