{
  "area": "census",
  "faults": [
    {
      "id": "census-expected-count",
      "breaks": "The manifest's expected count differs by one",
      "check": "check_census.py exact comparison",
      "inputs": [
        {
          "file": "scripts/faults/fixtures/census_manifest.json",
          "op": "json_set",
          "path": [
            "days",
            "all-types",
            "per_type_counts",
            "A"
          ],
          "value": 2
        },
        {
          "file": "scripts/faults/fixtures/census_manifest.json",
          "op": "json_set",
          "path": [
            "days",
            "all-types",
            "messages"
          ],
          "value": 25
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "itch_census"
        ]
      },
      "command": [
        "{python}",
        "{tree}/scripts/check_census.py",
        "--day",
        "all-types",
        "--manifest",
        "{tree}/scripts/faults/fixtures/census_manifest.json",
        "--file",
        "{tree}/fuzz/corpus/fuzz_reader/stream-all-types",
        "--census",
        "{build}/tools/itch_census"
      ],
      "expect": {
        "signature": "census: MISMATCH type A: manifest 2, census 1",
        "exit": 1
      }
    },
    {
      "id": "census-expected-last-message",
      "breaks": "The manifest's last-message timestamp differs by one",
      "check": "check_census.py exact comparison",
      "inputs": [
        {
          "file": "scripts/faults/fixtures/census_manifest.json",
          "op": "json_set",
          "path": [
            "days",
            "all-types",
            "last_message",
            "timestamp_ns"
          ],
          "value": 72297776244616
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "itch_census"
        ]
      },
      "command": [
        "{python}",
        "{tree}/scripts/check_census.py",
        "--day",
        "all-types",
        "--manifest",
        "{tree}/scripts/faults/fixtures/census_manifest.json",
        "--file",
        "{tree}/fuzz/corpus/fuzz_reader/stream-all-types",
        "--census",
        "{build}/tools/itch_census"
      ],
      "expect": {
        "signature": "census: MISMATCH last_message\\.timestamp_ns: manifest 72297776244616, census 72297776244617",
        "exit": 1
      }
    },
    {
      "id": "census-input-cut-mid-frame",
      "breaks": "The day loses its final byte",
      "check": "check_census.py, typed end state",
      "inputs": [
        {
          "file": "fuzz/corpus/fuzz_reader/stream-all-types",
          "op": "truncate",
          "size": -1
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "itch_census"
        ]
      },
      "command": [
        "{python}",
