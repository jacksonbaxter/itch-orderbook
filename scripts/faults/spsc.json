      "command": [
        "{build}/tests/test_spsc"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] SpscRing\\.KeepsOrderInEveryConfiguration"
      }
    },
    {
      "id": "spsc-padding-constant",
      "breaks": "The ring pads to 64 on Apple silicon and to 128 on x86-64, the other target's line",
      "check": "test_spsc's static_assert against the compiler's target",
      "mutations": [
        {
          "file": "cmake/ItchCacheLine.cmake",
          "old": "  set(ITCH_CACHE_LINE 128)\nelseif(itch_target_arch MATCHES \"^(x86_64|AMD64|amd64)$\")\n  set(ITCH_CACHE_LINE 64)",
          "new": "  set(ITCH_CACHE_LINE 64)\nelseif(itch_target_arch MATCHES \"^(x86_64|AMD64|amd64)$\")\n  set(ITCH_CACHE_LINE 128)"
        }
      ],
      "build": {
        "preset": "release",
        "targets": []
      },
      "command": [
        "cmake",
        "--build",
        "--preset",
        "release",
        "--parallel",
        "3",
        "--target",
        "test_spsc"
      ],
      "expect": {
        "signature": "(Apple silicon moves 128-byte lines|x86-64 moves 64-byte lines)"
      }
    },
    {
      "id": "spsc-shipped-unpadded",
      "breaks": "The shipped ring pads each side to 8 bytes, so both indices share a line",
      "check": "test_spsc PadsEachSideToItsOwnLine",
