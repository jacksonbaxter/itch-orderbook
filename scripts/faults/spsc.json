{
  "area": "spsc",
  "faults": [
    {
      "id": "spsc-publish-relaxed",
      "breaks": "The producer publishes its index with relaxed, so the slot's write need not be seen before the index",
      "check": "ThreadSanitizer on test_spsc's two threads, no recovery",
      "mutations": [
        {
          "file": "include/itch/spsc.hpp",
          "old": "kPublish = std::memory_order_release;",
          "new": "kPublish = std::memory_order_relaxed;"
        }
      ],
      "build": {
        "preset": "tsan",
        "targets": [
          "test_spsc"
        ]
      },
      "command": [
        "ctest",
        "--preset",
        "tsan",
        "-R",
        "^test_spsc$"
      ],
      "expect": {
        "signature": "ThreadSanitizer: data race"
      }
    },
    {
      "id": "spsc-reclaim-relaxed",
      "breaks": "The producer reads the consumer's index with relaxed, so it may write over a slot still being read",
      "check": "ThreadSanitizer on test_spsc's two threads, no recovery",
      "mutations": [
        {
          "file": "include/itch/spsc.hpp",
          "old": "kReclaim = std::memory_order_acquire;",
          "new": "kReclaim = std::memory_order_relaxed;"
        }
      ],
      "build": {
        "preset": "tsan",
        "targets": [
          "test_spsc"
        ]
      },
      "command": [
        "ctest",
        "--preset",
        "tsan",
        "-R",
        "^test_spsc$"
      ],
      "expect": {
        "signature": "ThreadSanitizer: data race"
      }
    },
    {
      "id": "spsc-mask-off-by-one",
      "breaks": "The mask is one short of capacity - 1, so two indices a slot apart share a slot",
      "check": "test_spsc KeepsOrderInEveryConfiguration",
      "mutations": [
        {
          "file": "include/itch/spsc.hpp",
          "old": ".mask = slots_for(capacity) - 1}",
          "new": ".mask = slots_for(capacity) - 2}"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_spsc"
        ]
      },
      "command": [
        "{build}/tests/test_spsc"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] SpscRing\\.KeepsOrderInEveryConfiguration"
      }
    },
    {
      "id": "spsc-stress-mask-off-by-one",
      "breaks": "The mask is one short of capacity - 1, so two indices a slot apart share a slot",
      "check": "spsc_stress, without TSan, by order and content",
      "mutations": [
        {
          "file": "include/itch/spsc.hpp",
          "old": ".mask = slots_for(capacity) - 1}",
          "new": ".mask = slots_for(capacity) - 2}"
        }
