      "id": "spsc-batch-publishes-one",
      "breaks": "A batch push publishes one slot however many it wrote",
      "check": "test_spsc KeepsOrderInEveryConfiguration",
      "mutations": [
        {
          "file": "include/itch/spsc.hpp",
          "old": "producer_.tail.store(tail + count, Ordering::kPublish);",
          "new": "producer_.tail.store(tail + 1, Ordering::kPublish);"
