      "expect": {
        "signature": "spsc_stress: FAIL",
        "exit": 1
      }
    },
    {
      "id": "spsc-cached-head-refreshed-wrong",
      "breaks": "The producer refreshes its copy of the consumer's index from its own tail, so it sees a full ring as empty",
      "check": "test_spsc StopsAtFullAndEmpty",
      "mutations": [
        {
          "file": "include/itch/spsc.hpp",
          "old": "producer_.cached_head = consumer_.head.load(Ordering::kReclaim);",
          "new": "producer_.cached_head = tail;"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_spsc"
        ]
      },
      "command": [
        "{build}/tests/test_spsc"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] SpscRing\\.StopsAtFullAndEmpty"
      }
    },
    {
      "id": "spsc-cached-tail-never-refreshed",
      "breaks": "The consumer reads its stale copy of the producer's index where it should reload it",
      "check": "test_spsc KeepsOrderInEveryConfiguration",
      "mutations": [
        {
          "file": "include/itch/spsc.hpp",
          "old": "consumer_.cached_tail = producer_.tail.load(Ordering::kObserve);\n        ready = consumer_.cached_tail - head;",
          "new": "ready = consumer_.cached_tail - head;"
        }
      ],
      "build": {
        "preset": "release",
        "targets": [
          "test_spsc"
        ]
      },
      "command": [
        "{build}/tests/test_spsc"
      ],
      "expect": {
        "signature": "\\[  FAILED  \\] SpscRing\\.KeepsOrderInEveryConfiguration"
      }
    },
