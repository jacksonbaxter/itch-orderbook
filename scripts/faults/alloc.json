   "id": "alloc-pool-lifo-loses-the-freed-node",
   "breaks": "The LIFO pool never puts a node given back on its free list",
   "check": "test_node_book NodePool.LifoGivesTheNodeFreedLastFirst",
   "mutations": [
    {
     "file": "include/itch/node_pool.hpp",
     "old": "      set_link(node, head_);\n      head_ = node;\n",
     "new": "      set_link(node, head_);\n"
    }
   ],
   "build": {
    "preset": "release",
    "targets": [
     "test_node_book"
    ]
   },
   "command": [
    "{build}/tests/test_node_book",
    "--gtest_filter=NodePool.*"
   ],
   "expect": {
    "signature": "\\[  FAILED  \\] NodePool\\.LifoGivesTheNodeFreedLastFirst"
   }
  },
  {
   "id": "alloc-pool-fifo-reuses-newest",
   "breaks": "The FIFO pool puts a node given back at the head, so it reuses the newest as LIFO does",
   "check": "test_node_book NodePool.FifoGivesTheNodeFreedFirstFirst",
   "mutations": [
    {
     "file": "include/itch/node_pool.hpp",
     "old": "      set_link(node, kNull);\n      if (tail_ == kNull) {\n        head_ = node;\n      } else {\n        set_link(tail_, node);\n      }\n      tail_ = node;\n",
     "new": "      set_link(node, head_);\n      tail_ = head_ == kNull ? node : tail_;\n      head_ = node;\n"
    }
   ],
   "build": {
    "preset": "release",
    "targets": [
     "test_node_book"
    ]
   },
   "command": [
    "{build}/tests/test_node_book",
    "--gtest_filter=NodePool.*"
   ],
   "expect": {
    "signature": "\\[  FAILED  \\] NodePool\\.FifoGivesTheNodeFreedFirstFirst"
   }
  },
